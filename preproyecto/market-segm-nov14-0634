        "### Como se ve en el grafico anterior los precios inter-canales son muy dispares  \n",
        "### No hay un canal mas barato que otro para cada producto\n",
        "=> No veo otra opcion que usar un costo de **PROMOCION PROMEDIO / producto**"
      ],
      "metadata": {
        "id": "aJrVfMl_P-tJ"
      }
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 144
        },
        "outputId": "0d4253e3-3fdb-4ce2-fe06-1773b2c34f85",
        "id": "l4FGGNUVP20h"
      },
      "source": [
        "# Calcula el precio maximo para cada producto\n",
        "max_prices_per_product = df_marketing.groupby('prod_gener')['costo_prom'].max().reset_index()\n",
        "max_prices_per_product.rename(columns={'costo_prom': 'max_costo_product'}, inplace=True)\n",
        "\n",
        "# Merge de vuelta con original DataFrame para encontrar el canal con precio max\n",
        "df_max_price_channels = pd.merge(\n",
        "    df_marketing,\n",
        "    max_prices_per_product,\n",
        "    on='prod_gener',\n",
        "    how='left'\n",
        ")\n",
        "\n",
        "# Filtrar para obtener solamente las filas donde el costo del producto es costo max\n",
        "# Esto maneja casos donde multiple canales podrian tener el mismo precio\n",
        "# max price para un producto\n",
        "max_channel_per_product = df_max_price_channels[df_max_price_channels['costo_prom'] == df_max_price_channels['max_costo_product']]\n",
        "\n",
        "# Descarta duplicados producto-canal pares si un producto aparece multiples veces\n",
        "# con el mismo precio max para el mismo canal\n",
        "# Por ej, si 'Adorno de pared' has max cost 5.08 for 'Email' twice, we only\n",
        "# count 'Email' once for that product\n",
        "max_channel_per_product_unique = max_channel_per_product.drop_duplicates(subset=['prod_gener', 'canal', 'max_costo_product'])\n",
        "\n",
        "# Cuenta cuantas veces cada canal tiene el precio maximo para un producto\n",
        "channel_max_price_counts = max_channel_per_product_unique['canal'].value_counts().reset_index()\n",
        "channel_max_price_counts.columns = ['Channel', 'Count_of_Max_Prices']\n",
        "\n",
        "display(channel_max_price_counts)\n"
      ],
